# setup for .env.local

# CLERK
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# FastAPI is the primary repository submission API. Next.js keeps its existing
# action as a fallback if this service is unavailable.
FASTAPI_URL=http://127.0.0.1:8000

# LANGSMITH
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cartograph
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# AI provider: auto uses Gemini when GEMINI_API_KEY is set; otherwise OpenAI.
# Set to "openai" or "gemini" to choose explicitly.
AI_PROVIDER=auto

# OPENAI
OPENAI_API_KEY=

# GEMINI (create a key in Google AI Studio; the API endpoint is set in code)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional local fallback when the selected cloud provider hits its quota.
# For llama.cpp, use the OpenAI-compatible API base URL and the model ID from GET /v1/models.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# Agent Service (deep-agent/, `pnpm dev` there).
AGENT_URL=http://localhost:2024
